{
  "name": "@noob-stupid/dsh-plugin-console",
  "version": "0.4.0-beta.4",
  "description": "分层重构预览版（实验性，勿用于生产）— dsh-plugin-hub 的实验分支线",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noob-stupid/dsh-plugin-hub-refactor.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "SECURITY.md"
  ],
  "license": "MIT",
  "scripts": {
    "checkBom": "node -e \"const fs=require('fs');const b=fs.readFileSync('package.json');if(b[0]===0xEF){console.error('BOM detected in package.json — strip it before publish');process.exit(1)};console.log('package.json BOM check OK')\"",
    "prepublishOnly": "npm run checkBom"
  },
  "private": true
}
